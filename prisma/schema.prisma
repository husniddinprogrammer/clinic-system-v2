// Prisma schema for Clinic Management System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
}

enum PaymentType {
  CASH
  CARD
  CLICK
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password_hash String
  full_name    String
  role         Role     @default(DOCTOR)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  visits Visit[]

  @@index([role])
}

model Patient {
  id         Int       @id @default(autoincrement())
  full_name  String
  birth_date DateTime?
  phone      String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  visits Visit[]

  @@index([full_name])
  @@index([phone])
}

model Visit {
  id              Int       @id @default(autoincrement())
  patient_id      Int
  doctor_id       Int
  diagnosis       String?
  visit_date      DateTime  @default(now())
  performed_work  String?
  payment_amount  Decimal?  @db.Decimal(12, 2)
  payment_type    PaymentType?
  additional_info String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  User    @relation(fields: [doctor_id], references: [id], onDelete: Restrict)

  @@index([patient_id])
  @@index([doctor_id])
  @@index([visit_date])
}

model ClinicSettings {
  id         Int      @id @default(1)
  name       String   @default("Klinika")
  logo       Bytes?
  logo_mime  String?
  updated_at DateTime @updatedAt
}
