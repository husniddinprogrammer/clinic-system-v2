// Prisma schema for Clinic Management System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
}

enum PaymentType {
  CASH
  CARD
  CLICK
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password_hash String
  full_name    String
  role         Role     @default(DOCTOR)
  permissions  Json?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  visits Visit[]

  @@index([role])
}

model Patient {
  id         Int       @id @default(autoincrement())
  full_name  String
  birth_date DateTime?
  phone      String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  visits   Visit[]
  labWorks LabWork[]

  @@index([full_name])
  @@index([phone])
}

model Visit {
  id              Int       @id @default(autoincrement())
  patient_id      Int
  doctor_id       Int
  diagnosis       String?
  visit_date      DateTime  @default(now())
  performed_work  String?
  payment_amount  Decimal?  @db.Decimal(12, 2)
  payment_type    PaymentType?
  additional_info String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  User    @relation(fields: [doctor_id], references: [id], onDelete: Restrict)

  @@index([patient_id])
  @@index([doctor_id])
  @@index([visit_date])
}

enum ActivityType {
  PAYMENT
  VISIT
  PATIENT
  DOCTOR
  LOGIN
  EXPENSE
  LABWORK
  EMPLOYEE
}

enum ExpenseCategory {
  DOSTAVKA
  OVQAT
  ISHCHI
  BOSHQA
}

enum LabWorkType {
  ZIRCON
  MK_500
  CLITOY_300
  TITAN_250
}

model Employee {
  id         Int      @id @default(autoincrement())
  first_name String
  last_name  String
  position   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  expenses Expense[]
  labWorks LabWork[]

  @@index([last_name])
}

model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  date        DateTime        @default(now())
  employee_id Int?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  employee Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

model LabWork {
  id           Int          @id @default(autoincrement())
  patient_id   Int
  employee_id  Int
  work_type    LabWorkType
  work_date    DateTime     @default(now())
  price        Decimal      @db.Decimal(12, 2)
  payment_type PaymentType?
  is_active    Boolean      @default(true)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  patient  Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Restrict)

  @@index([patient_id])
  @@index([employee_id])
  @@index([work_date])
}

model ActivityLog {
  id         Int          @id @default(autoincrement())
  type       ActivityType
  action     String
  message    String
  user_id    Int?
  user_name  String?
  entity_id  Int?
  created_at DateTime     @default(now())

  @@index([type])
  @@index([created_at])
}

model ClinicSettings {
  id         Int      @id @default(1)
  name       String   @default("Klinika")
  logo       Bytes?
  logo_mime  String?
  updated_at DateTime @updatedAt
}
